rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isProgramOwner(programId) {
      return isSignedIn()
             && get(/databases/$(database)/documents/programs/$(programId)).data.ownerId
                == request.auth.uid;
    }

    function isEnrolledActive(programId) {
      let enrollmentId = programId + '_' + request.auth.uid;
      return isSignedIn()
             && exists(/databases/$(database)/documents/enrollments/$(enrollmentId))
             && get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.status
                == 'active';
    }

    function relationshipId(trainerId, athleteId) {
      return trainerId + '_' + athleteId;
    }

    function hasActiveTrainerClientRelationship(trainerId, athleteId) {
      let id = relationshipId(trainerId, athleteId);
      return isSignedIn()
             && exists(/databases/$(database)/documents/trainerClientRelationships/$(id))
             && get(/databases/$(database)/documents/trainerClientRelationships/$(id)).data.status
                == 'active';
    }

    function hasManageableTrainerClientRelationship(trainerId, athleteId) {
      let id = relationshipId(trainerId, athleteId);
      return isSignedIn()
             && exists(/databases/$(database)/documents/trainerClientRelationships/$(id))
             && get(/databases/$(database)/documents/trainerClientRelationships/$(id)).data.status
                in ['active', 'ending'];
    }

    function templateOwner(data) {
      return 'ownerId' in data ? data.ownerId : data.createdBy;
    }

    function preservesTemplateOwnership() {
      return request.resource.data.createdBy == resource.data.createdBy
             && request.resource.data.ownerId == templateOwner(resource.data);
    }

    function templateVersion(data) {
      return 'currentVersion' in data ? data.currentVersion : 0;
    }

    function libraryFolderType(data) {
      return 'itemType' in data ? data.itemType : 'program';
    }

    function hasValidTags(data) {
      return !('tags' in data)
             || (data.tags is list && data.tags.size() <= 20);
    }

    function hasValidProvenance(data) {
      return !('provenance' in data)
             || data.provenance == null
             || (data.provenance is map
                 && data.provenance.keys().hasOnly([
                      'sourceTemplateId', 'sourceOwnerId', 'sourceVersion',
                      'copiedAt', 'copiedBy'
                    ])
                 && data.provenance.sourceTemplateId is string
                 && data.provenance.sourceTemplateId.size() > 0
                 && data.provenance.sourceOwnerId is string
                 && data.provenance.sourceOwnerId.size() > 0
                 && data.provenance.sourceVersion is int
                 && data.provenance.sourceVersion >= 0
                 && data.provenance.copiedAt is timestamp
                 && data.provenance.copiedBy is string
                 && data.provenance.copiedBy.size() > 0);
    }

    function hasValidProvenanceSource(data, itemType) {
      return !('provenance' in data)
             || data.provenance == null
             || (itemType == 'exercise'
                 && exists(
                      /databases/$(database)/documents/exerciseTemplates/$(data.provenance.sourceTemplateId)
                    )
                 && data.provenance.sourceOwnerId == templateOwner(
                      get(
                        /databases/$(database)/documents/exerciseTemplates/$(data.provenance.sourceTemplateId)
                      ).data
                    )
                 && ((templateVersion(
                        get(
                          /databases/$(database)/documents/exerciseTemplates/$(data.provenance.sourceTemplateId)
                        ).data
                      ) == 0
                      && data.provenance.sourceVersion == 1)
                     || exists(
                          /databases/$(database)/documents/exerciseTemplates/$(data.provenance.sourceTemplateId)/exerciseVersions/$(data.provenance.sourceVersion)
                        )))
             || (itemType == 'workout'
                 && exists(
                      /databases/$(database)/documents/workoutTemplates/$(data.provenance.sourceTemplateId)
                    )
                 && data.provenance.sourceOwnerId == templateOwner(
                      get(
                        /databases/$(database)/documents/workoutTemplates/$(data.provenance.sourceTemplateId)
                      ).data
                    )
                 && ((templateVersion(
                        get(
                          /databases/$(database)/documents/workoutTemplates/$(data.provenance.sourceTemplateId)
                        ).data
                      ) == 0
                      && data.provenance.sourceVersion == 0)
                     || exists(
                          /databases/$(database)/documents/workoutTemplates/$(data.provenance.sourceTemplateId)/workoutTemplateVersions/$(data.provenance.sourceVersion)
                        )))
             || (itemType == 'program'
                 && exists(
                      /databases/$(database)/documents/programs/$(data.provenance.sourceTemplateId)
                    )
                 && data.provenance.sourceOwnerId
                    == get(
                         /databases/$(database)/documents/programs/$(data.provenance.sourceTemplateId)
                       ).data.ownerId
                 && ((templateVersion(
                        get(
                          /databases/$(database)/documents/programs/$(data.provenance.sourceTemplateId)
                        ).data
                      ) == 0
                      && data.provenance.sourceVersion == 0)
                     || exists(
                          /databases/$(database)/documents/programs/$(data.provenance.sourceTemplateId)/programVersions/$(data.provenance.sourceVersion)
                        )));
    }

    function preservesProvenance() {
      return (!('provenance' in resource.data)
              && (!('provenance' in request.resource.data)
                  || request.resource.data.provenance == null))
             || (('provenance' in resource.data)
                 && ('provenance' in request.resource.data)
                 && request.resource.data.provenance
                    == resource.data.provenance);
    }

    function hasValidLibraryFolder(data, itemType) {
      return !('folderId' in data)
             || data.folderId == null
             || (data.folderId is string
                 && data.folderId.size() > 0
                 && exists(
                      /databases/$(database)/documents/programFolders/$(data.folderId)
                    )
                 && get(
                      /databases/$(database)/documents/programFolders/$(data.folderId)
                    ).data.ownerId == request.auth.uid
                 && (!('deletedAt' in get(
                        /databases/$(database)/documents/programFolders/$(data.folderId)
                      ).data)
                     || get(
                          /databases/$(database)/documents/programFolders/$(data.folderId)
                        ).data.deletedAt == null)
                 && libraryFolderType(
                      get(
                        /databases/$(database)/documents/programFolders/$(data.folderId)
                      ).data
                    ) == itemType);
    }

    function hasValidLibraryMetadata(data, itemType) {
      return hasValidTags(data)
             && hasValidProvenance(data)
             && hasValidProvenanceSource(data, itemType)
             && hasValidLibraryFolder(data, itemType);
    }

    function hasValidLibraryMetadataUpdate(data, itemType) {
      return hasValidTags(data)
             && hasValidProvenance(data)
             && (!request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['folderId'])
                 || hasValidLibraryFolder(data, itemType));
    }

    function publishesNextExerciseVersion(templateId) {
      let nextVersion = templateVersion(resource.data) + 1;
      return request.resource.data.currentVersion == nextVersion
             && existsAfter(
               /databases/$(database)/documents/exerciseTemplates/$(templateId)/exerciseVersions/$(nextVersion)
             );
    }

    function publishesLegacyExerciseEdit(templateId) {
      return templateVersion(resource.data) == 0
             && request.resource.data.currentVersion == 2
             && existsAfter(
               /databases/$(database)/documents/exerciseTemplates/$(templateId)/exerciseVersions/1
             )
             && existsAfter(
               /databases/$(database)/documents/exerciseTemplates/$(templateId)/exerciseVersions/2
             );
    }

    function preservesLegacyExerciseAsVersionOne(templateId) {
      let version = getAfter(
        /databases/$(database)/documents/exerciseTemplates/$(templateId)/exerciseVersions/1
      ).data;
      return !('name' in request.resource.data)
             && !('description' in request.resource.data)
             && !('instructions' in request.resource.data)
             && !('videoUrl' in request.resource.data)
             && !('mediaUrls' in request.resource.data)
             && !('exerciseType' in request.resource.data)
             && !('measurementConfiguration' in request.resource.data)
             && !('gradingConfiguration' in request.resource.data)
             && version.name
                == ('name' in resource.data ? resource.data.name : '')
             && version.description
                == ('description' in resource.data
                    ? resource.data.description : '')
             && version.instructions
                == ('instructions' in resource.data
                    ? resource.data.instructions : '')
             && version.videoUrl
                == ('videoUrl' in resource.data ? resource.data.videoUrl : null)
             && version.mediaUrls
                == ('mediaUrls' in resource.data ? resource.data.mediaUrls : [])
             && version.exerciseType
                == ('exerciseType' in resource.data
                    ? resource.data.exerciseType : 'other')
             && version.measurementConfiguration
                == ('measurementConfiguration' in resource.data
                    ? resource.data.measurementConfiguration
                    : {'primary': 'repetitions', 'secondary': []})
             && version.gradingConfiguration
                == ('gradingConfiguration' in resource.data
                    ? resource.data.gradingConfiguration : null);
    }

    function publishesNextWorkoutVersion(templateId) {
      let nextVersion = templateVersion(resource.data) + 1;
      let version = getAfter(
        /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(nextVersion)
      );
      return request.resource.data.currentVersion == nextVersion
             && version != null
             && (!('publishState' in version.data)
                 || (version.data.publishState == 'published'
                     && hasAllTypedBlockChildren(
                          templateId,
                          string(nextVersion),
                          version.data
                        )));
    }

    function publishesNextProgramVersion(programId) {
      let nextVersion = templateVersion(resource.data) + 1;
      return request.resource.data.currentVersion == nextVersion
             && existsAfter(
                  /databases/$(database)/documents/programs/$(programId)/programVersions/$(nextVersion)
                );
    }

    function isOwnedExerciseVersion(exerciseId, versionNumber) {
      let exercise = get(
        /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
      ).data;
      return templateOwner(exercise) == request.auth.uid
             && ((!('currentVersion' in exercise) && versionNumber == 1)
                 || ('currentVersion' in exercise
                     && exercise.currentVersion >= 1
                     && versionNumber >= 1
                     && versionNumber <= templateVersion(exercise)));
    }

    function hasValidWorkoutBlock(data) {
      return data.keys().hasOnly([
               'blockId', 'type', 'sortOrder', 'title', 'notes', 'rounds',
               'workSeconds', 'restSeconds', 'restBetweenRoundsSeconds',
               'grade', 'color', 'targetAttempts', 'slotIds',
               'slotStartOrder', 'slotCount'
             ])
             && data.blockId is string
             && data.blockId.size() > 0
             && data.sortOrder is int
             && data.sortOrder >= 0
             && data.slotIds is list
             && data.slotIds.size() >= 1
             && data.slotIds.size() <= 9
             && data.slotIds.toSet().size() == data.slotIds.size()
             && data.slotStartOrder is int
             && data.slotStartOrder >= 0
             && data.slotCount == data.slotIds.size()
             && data.type in [
                  'standardExercise', 'timedInterval', 'circuit',
                  'climbingRoute'
                ]
             && (!(data.type in ['standardExercise', 'climbingRoute'])
                 || data.slotCount == 1)
             && (data.type != 'timedInterval'
                 || (data.rounds is int
                     && data.rounds >= 1
                     && data.workSeconds is int
                     && data.workSeconds >= 1
                     && data.restSeconds is int
                     && data.restSeconds >= 0))
             && (data.type != 'circuit'
                 || (data.rounds is int
                     && data.rounds >= 1
                     && data.restBetweenRoundsSeconds is int
                     && data.restBetweenRoundsSeconds >= 0))
             && (data.type != 'climbingRoute'
                 || (data.grade is string
                     && data.grade.size() > 0
                     && data.color is string
                     && data.color.size() > 0
                     && (!('targetAttempts' in data)
                         || data.targetAttempts == null
                         || (data.targetAttempts is int
                             && data.targetAttempts >= 1))));
    }

    function hasValidWorkoutSlot(data) {
      return data.keys().hasOnly([
               'slotId', 'blockId', 'exerciseId', 'exerciseVersion',
               'sortOrder', 'exerciseName', 'prescription',
               'blockSortOrder', 'slotOrder'
             ])
             && data.slotId is string
             && data.slotId.size() > 0
             && data.blockId is string
             && data.blockId.size() > 0
             && data.blockSortOrder is int
             && data.blockSortOrder >= 0
             && data.slotOrder is int
             && data.slotOrder >= 0
             && data.sortOrder is int
             && data.sortOrder >= 0
             && data.exerciseId is string
             && data.exerciseId.size() > 0
             && data.exerciseVersion is int
             && data.exerciseVersion >= 1
             && data.prescription is map;
    }

    function hasValidTypedWorkoutVersion(data) {
      return data.blockCount is int
             && data.blockCount >= 0
             && data.blockCount <= 9
             && data.slotCount is int
             && data.slotCount >= 0
             && data.slotCount <= 9
             && data.blockIds is list
             && data.blockIds.size() == data.blockCount
             && data.blockIds.toSet().size() == data.blockIds.size()
             && data.slotIds is list
             && data.slotIds.size() == data.slotCount
             && data.slotIds.toSet().size() == data.slotIds.size()
             && data.blocks is list
             && data.blocks.size() == data.blockCount
             && data.slots is list
             && data.slots.size() == data.slotCount
             && (data.blockCount != 0 || data.slotCount == 0);
    }

    function hasTypedBlockChild(templateId, versionNumber, data, index) {
      return data.blockCount <= index
             || existsAfter(
                  /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)/workoutBlocks/$(data.blockIds[index])
                );
    }

    function hasTypedSlotChild(templateId, versionNumber, data, index) {
      return data.slotCount <= index
             || existsAfter(
                  /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)/exerciseSlots/$(data.slotIds[index])
                );
    }

    function hasAllTypedBlockChildren(templateId, versionNumber, data) {
      return hasTypedBlockChild(templateId, versionNumber, data, 0)
             && hasTypedBlockChild(templateId, versionNumber, data, 1)
             && hasTypedBlockChild(templateId, versionNumber, data, 2)
             && hasTypedBlockChild(templateId, versionNumber, data, 3)
             && hasTypedBlockChild(templateId, versionNumber, data, 4)
             && hasTypedBlockChild(templateId, versionNumber, data, 5)
             && hasTypedBlockChild(templateId, versionNumber, data, 6)
             && hasTypedBlockChild(templateId, versionNumber, data, 7)
             && hasTypedBlockChild(templateId, versionNumber, data, 8);
    }

    function hasAllTypedSlotChildren(templateId, versionNumber, data) {
      return hasTypedSlotChild(templateId, versionNumber, data, 0)
             && hasTypedSlotChild(templateId, versionNumber, data, 1)
             && hasTypedSlotChild(templateId, versionNumber, data, 2)
             && hasTypedSlotChild(templateId, versionNumber, data, 3)
             && hasTypedSlotChild(templateId, versionNumber, data, 4)
             && hasTypedSlotChild(templateId, versionNumber, data, 5)
             && hasTypedSlotChild(templateId, versionNumber, data, 6)
             && hasTypedSlotChild(templateId, versionNumber, data, 7)
             && hasTypedSlotChild(templateId, versionNumber, data, 8);
    }

    function hasNoTypedBlockChild(templateId, versionNumber, data, index) {
      return data.blockCount <= index
             || !existsAfter(
                  /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)/workoutBlocks/$(data.blockIds[index])
                );
    }

    function hasNoTypedSlotChild(templateId, versionNumber, data, index) {
      return data.slotCount <= index
             || !existsAfter(
                  /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)/exerciseSlots/$(data.slotIds[index])
                );
    }

    function hasNoTypedBlockChildren(templateId, versionNumber, data) {
      return hasNoTypedBlockChild(templateId, versionNumber, data, 0)
             && hasNoTypedBlockChild(templateId, versionNumber, data, 1)
             && hasNoTypedBlockChild(templateId, versionNumber, data, 2)
             && hasNoTypedBlockChild(templateId, versionNumber, data, 3)
             && hasNoTypedBlockChild(templateId, versionNumber, data, 4)
             && hasNoTypedBlockChild(templateId, versionNumber, data, 5)
             && hasNoTypedBlockChild(templateId, versionNumber, data, 6)
             && hasNoTypedBlockChild(templateId, versionNumber, data, 7)
             && hasNoTypedBlockChild(templateId, versionNumber, data, 8);
    }

    function hasNoTypedSlotChildren(templateId, versionNumber, data) {
      return hasNoTypedSlotChild(templateId, versionNumber, data, 0)
             && hasNoTypedSlotChild(templateId, versionNumber, data, 1)
             && hasNoTypedSlotChild(templateId, versionNumber, data, 2)
             && hasNoTypedSlotChild(templateId, versionNumber, data, 3)
             && hasNoTypedSlotChild(templateId, versionNumber, data, 4)
             && hasNoTypedSlotChild(templateId, versionNumber, data, 5)
             && hasNoTypedSlotChild(templateId, versionNumber, data, 6)
             && hasNoTypedSlotChild(templateId, versionNumber, data, 7)
             && hasNoTypedSlotChild(templateId, versionNumber, data, 8);
    }

    function blockSlotMatchesManifest(version, block, index) {
      return block.slotCount <= index
             || (block.slotStartOrder + index < version.slotCount
                 && block.slotIds[index]
                    == version.slotIds[block.slotStartOrder + index]);
    }

    function hasValidBlockManifestRange(version, block) {
      return block.sortOrder < version.blockCount
             && version.blockIds[block.sortOrder] == block.blockId
             && (block.sortOrder != 0 || block.slotStartOrder == 0)
             && (block.sortOrder == 0
                 || block.slotStartOrder
                    == version.blocks[block.sortOrder - 1].slotStartOrder
                       + version.blocks[block.sortOrder - 1].slotCount)
             && (block.sortOrder != version.blockCount - 1
                 || block.slotStartOrder + block.slotCount
                    == version.slotCount)
             && blockSlotMatchesManifest(version, block, 0)
             && blockSlotMatchesManifest(version, block, 1)
             && blockSlotMatchesManifest(version, block, 2)
             && blockSlotMatchesManifest(version, block, 3)
             && blockSlotMatchesManifest(version, block, 4)
             && blockSlotMatchesManifest(version, block, 5)
             && blockSlotMatchesManifest(version, block, 6)
             && blockSlotMatchesManifest(version, block, 7)
             && blockSlotMatchesManifest(version, block, 8);
    }

    function canReadWorkoutVersionChild(templateId, versionNumber) {
      let version = get(
        /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
      ).data;
      return isSignedIn()
             && (!('publishState' in version)
                 || version.publishState == 'published'
                 || version.ownerId == request.auth.uid);
    }

    function canDeleteDraftWorkoutVersionChild(templateId, versionNumber) {
      let version = get(
        /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
      ).data;
      return isSignedIn()
             && version.storageFormat == 'typedWorkoutBlocksV1'
             && version.publishState == 'deleting'
             && version.ownerId == request.auth.uid
             && templateVersion(
                  get(
                    /databases/$(database)/documents/workoutTemplates/$(templateId)
                  ).data
                ) + 1 == version.versionNumber;
    }

    function workoutInstanceData(instanceId) {
      return get(
        /databases/$(database)/documents/workoutInstances/$(instanceId)
      ).data;
    }

    function workoutVersionData(instanceId) {
      let instance = workoutInstanceData(instanceId);
      return get(
        /databases/$(database)/documents/workoutTemplates/$(instance.workoutTemplateId)/workoutTemplateVersions/$(instance.workoutTemplateVersion)
      ).data;
    }

    function hasValidResultSlot(instanceId, slotId, data) {
      let instance = workoutInstanceData(instanceId);
      let version = workoutVersionData(instanceId);
      return (version.storageFormat == 'typedWorkoutBlocksV1'
              && version.slots is list
              && data.slotOrder < version.slots.size()
              && version.slots[data.slotOrder].slotId == slotId
              && version.slots[data.slotOrder].exerciseId == data.exerciseId)
             || (version.storageFormat == 'typedWorkoutBlocksV1'
              && !('slots' in version)
              && exists(
                   /databases/$(database)/documents/workoutTemplates/$(instance.workoutTemplateId)/workoutTemplateVersions/$(instance.workoutTemplateVersion)/exerciseSlots/$(data.slotOrder)
                 )
              && get(
                   /databases/$(database)/documents/workoutTemplates/$(instance.workoutTemplateId)/workoutTemplateVersions/$(instance.workoutTemplateVersion)/exerciseSlots/$(data.slotOrder)
                 ).data.slotId == slotId
              && get(
                   /databases/$(database)/documents/workoutTemplates/$(instance.workoutTemplateId)/workoutTemplateVersions/$(instance.workoutTemplateVersion)/exerciseSlots/$(data.slotOrder)
                 ).data.exerciseId == data.exerciseId)
             || (version.storageFormat
                    == 'exercisePrescriptionSubcollection'
                 && exists(
                      /databases/$(database)/documents/workoutTemplates/$(instance.workoutTemplateId)/workoutTemplateVersions/$(instance.workoutTemplateVersion)/exercisePrescriptions/$(data.slotOrder)
                    )
                 && slotId == 'legacy-slot-' + string(data.slotOrder)
                 && get(
                      /databases/$(database)/documents/workoutTemplates/$(instance.workoutTemplateId)/workoutTemplateVersions/$(instance.workoutTemplateVersion)/exercisePrescriptions/$(data.slotOrder)
                    ).data.exerciseId == data.exerciseId)
             || (!('storageFormat' in version)
                 && version.exercises is list
                 && data.slotOrder < version.exercises.size()
                 && slotId == 'legacy-slot-' + string(data.slotOrder)
                 && version.exercises[data.slotOrder].exerciseId
                    == data.exerciseId);
    }

    function hasValidSlotResult(data) {
      return data.keys().hasOnly([
               'exerciseId', 'mode', 'sets', 'reps', 'durationSeconds',
               'weight', 'restSeconds', 'notes', 'slotOrder'
             ])
             && data.exerciseId is string
             && data.exerciseId.size() > 0
             && data.slotOrder is int
             && data.slotOrder >= 0
             && data.mode in ['reps', 'time', 'amrap']
             && (!('sets' in data)
                 || data.sets == null
                 || (data.sets is int && data.sets >= 1))
             && (!('reps' in data)
                 || data.reps == null
                 || data.reps is string)
             && (!('durationSeconds' in data)
                 || data.durationSeconds == null
                 || (data.durationSeconds is int
                     && data.durationSeconds >= 0))
             && (!('weight' in data)
                 || data.weight == null
                 || data.weight is string)
             && (!('restSeconds' in data)
                 || data.restSeconds == null
                 || (data.restSeconds is int && data.restSeconds >= 0))
             && (!('notes' in data)
                 || data.notes == null
                 || data.notes is string);
    }

    function isProgramAssignable(programId) {
      return get(/databases/$(database)/documents/programs/$(programId)).data.type
             == 'assignable';
    }

    function hasValidProgramOwner(data) {
      return data.programOwnerId
             == get(/databases/$(database)/documents/programs/$(data.programId))
                 .data.ownerId;
    }

    function workoutProgramOwner(data) {
      return 'programOwnerId' in data ? data.programOwnerId : data.assignedBy;
    }

    function hasActiveRelationshipForProgram(data) {
      let ownerId =
        get(/databases/$(database)/documents/programs/$(data.programId)).data.ownerId;
      return ownerId == data.athleteId
             || hasActiveTrainerClientRelationship(ownerId, data.athleteId);
    }

    function programInstanceData(instanceId) {
      return get(
        /databases/$(database)/documents/athleteProgramInstances/$(instanceId)
      ).data;
    }

    function programInstanceDataAfter(instanceId) {
      return getAfter(
        /databases/$(database)/documents/athleteProgramInstances/$(instanceId)
      ).data;
    }

    function hasValidProgramInstanceReference(data) {
      return !('athleteProgramInstanceId' in data)
             || data.athleteProgramInstanceId == null
             || (data.athleteProgramInstanceId is string
                 && existsAfter(
                      /databases/$(database)/documents/athleteProgramInstances/$(data.athleteProgramInstanceId)
                    )
                 && programInstanceDataAfter(data.athleteProgramInstanceId)
                       .athleteOwnerId == data.athleteId
                 && programInstanceDataAfter(data.athleteProgramInstanceId)
                       .sourceProgramId == data.programId
                 && programInstanceDataAfter(data.athleteProgramInstanceId)
                       .sourceProgramVersion == data.programVersion
                 && programInstanceDataAfter(data.athleteProgramInstanceId)
                       .assigningTrainerId == workoutProgramOwner(data)
                 && data.programAssignmentId
                       == data.athleteProgramInstanceId
                 && data.relationshipMode
                       == programInstanceDataAfter(
                            data.athleteProgramInstanceId
                          ).relationshipMode);
    }

    function isCurrentOrFutureWorkout(data) {
      return data.scheduledAt is timestamp
             && data.scheduledAt + duration.value(1, 'd') > request.time;
    }

    function canReadWorkout(data) {
      return data.athleteId == request.auth.uid
             || ((!('athleteProgramInstanceId' in data)
                  || data.athleteProgramInstanceId == null)
                 && (data.assignedBy == request.auth.uid
                     || data.programOwnerId == request.auth.uid))
             || (('athleteProgramInstanceId' in data)
                 && data.athleteProgramInstanceId != null
                 && programInstanceData(data.athleteProgramInstanceId)
                       .assigningTrainerId == request.auth.uid
                 && hasManageableTrainerClientRelationship(
                      request.auth.uid,
                      data.athleteId
                    ));
    }

    function canManageWorkoutSchedule(data) {
      return isCurrentOrFutureWorkout(data)
             && (data.athleteId == request.auth.uid
                 || ((data.programOwnerId == request.auth.uid
                      || data.assignedBy == request.auth.uid)
                     && hasActiveTrainerClientRelationship(
                          request.auth.uid,
                          data.athleteId
                        )));
    }

    function preservesProgramOwner() {
      return (!('programOwnerId' in resource.data)
              && (!('programOwnerId' in request.resource.data)
                 || hasValidProgramOwner(request.resource.data)))
             || (('programOwnerId' in resource.data)
                && request.resource.data.programOwnerId
                   == resource.data.programOwnerId);
    }

    function isProgramOwnerBackfill() {
      return !('programOwnerId' in resource.data)
             && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['programOwnerId'])
             && hasValidProgramOwner(request.resource.data);
    }

    function isProgramInstanceBackfill() {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.athleteId == request.auth.uid
             && !('athleteProgramInstanceId' in resource.data)
             && changed.hasOnly([
                  'athleteProgramInstanceId', 'relationshipMode'
                ])
             && hasValidProgramInstanceReference(request.resource.data);
    }

    function isProgramInstanceModeSync() {
      return resource.data.athleteId == request.auth.uid
             && resource.data.status == 'scheduled'
             && isCurrentOrFutureWorkout(resource.data)
             && resource.data.athleteProgramInstanceId is string
             && request.resource.data.athleteProgramInstanceId
                  == resource.data.athleteProgramInstanceId
             && programInstanceDataAfter(
                  resource.data.athleteProgramInstanceId
                ).relationshipMode == 'copied'
             && request.resource.data.relationshipMode == 'copied'
             && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly([
                    'relationshipMode', 'updatedAt'
                  ]);
    }

    function isEndingRelationshipModeSync() {
      let instanceId = resource.data.athleteProgramInstanceId;
      return resource.data.status == 'scheduled'
             && isCurrentOrFutureWorkout(resource.data)
             && instanceId is string
             && resource.data.programOwnerId == request.auth.uid
             && programInstanceData(instanceId).assigningTrainerId
                  == request.auth.uid
             && programInstanceData(instanceId).athleteOwnerId
                  == resource.data.athleteId
             && programInstanceData(instanceId).relationshipMode
                  == 'subscribed'
             && hasManageableTrainerClientRelationship(
                  request.auth.uid,
                  resource.data.athleteId
                )
             && get(
                  /databases/$(database)/documents/trainerClientRelationships/$(relationshipId(request.auth.uid, resource.data.athleteId))
                ).data.status == 'ending'
             && request.resource.data.relationshipMode == 'copied'
             && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly([
                    'relationshipMode', 'updatedAt'
                  ]);
    }

    function isAthleteCompletionUpdate() {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.status == 'completed'
             && resource.data.status == 'scheduled'
             && changed.hasOnly([
                  'status', 'completedAt', 'rpe', 'durationMinutes',
                  'loadPoints', 'loadStrategyId', 'athleteNotes',
                  'actualsStorageFormat', 'actualSlotIds',
                  'actualsBySlot', 'actuals', 'updatedAt'
                ]);
    }

    function isOwnerSchedulingUpdate() {
      return resource.data.status == 'scheduled'
             && request.resource.data.status in ['scheduled', 'cancelled']
             && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly([
                   'status', 'scheduledDate', 'workoutTemplateId',
                   'workoutTemplateVersion', 'workoutType', 'scheduledAt',
                   'updatedAt'
                 ])
             && isCurrentOrFutureWorkout(resource.data);
    }

    function isAthleteSchedulingUpdate() {
      return resource.data.status == 'scheduled'
             && request.resource.data.status in ['scheduled', 'cancelled']
             && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly([
                    'status', 'scheduledDate', 'scheduledAt', 'updatedAt'
                  ])
             && isCurrentOrFutureWorkout(resource.data)
             && (!('athleteProgramInstanceId' in resource.data)
                 || resource.data.athleteProgramInstanceId == null
                 || programInstanceData(
                      resource.data.athleteProgramInstanceId
                    ).relationshipMode == 'copied');
    }

    function canDeleteWorkout(data) {
      return (data.athleteId == request.auth.uid
              && (!('athleteProgramInstanceId' in data)
                  || data.athleteProgramInstanceId == null
                  || programInstanceData(data.athleteProgramInstanceId)
                       .relationshipMode == 'copied'))
             || ((data.programOwnerId == request.auth.uid
                  || data.assignedBy == request.auth.uid)
                 && hasActiveTrainerClientRelationship(
                      request.auth.uid,
                      data.athleteId
                    ));
    }

    function canTrainerManageWorkoutSchedule(data) {
      return isCurrentOrFutureWorkout(data)
             && (data.programOwnerId == request.auth.uid
                 || data.assignedBy == request.auth.uid)
             && data.athleteId != request.auth.uid
             && hasActiveTrainerClientRelationship(
                  request.auth.uid,
                  data.athleteId
                );
    }

    function hasDeclaredSlotResult(instanceId, data, index) {
      return data.actualSlotIds.size() <= index
             || existsAfter(
                 /databases/$(database)/documents/workoutInstances/$(instanceId)/slotResults/$(data.actualSlotIds[index])
                );
    }

    function hasCompleteDeclaredSlotResults(instanceId, data) {
      return data.actualsStorageFormat == 'slotResultsSubcollection'
             && data.actualSlotIds is list
             && data.actualSlotIds.size() <= 9
             && data.actualSlotIds.toSet().size()
                == data.actualSlotIds.size()
             && hasDeclaredSlotResult(instanceId, data, 0)
             && hasDeclaredSlotResult(instanceId, data, 1)
             && hasDeclaredSlotResult(instanceId, data, 2)
             && hasDeclaredSlotResult(instanceId, data, 3)
             && hasDeclaredSlotResult(instanceId, data, 4)
             && hasDeclaredSlotResult(instanceId, data, 5)
             && hasDeclaredSlotResult(instanceId, data, 6)
             && hasDeclaredSlotResult(instanceId, data, 7)
             && hasDeclaredSlotResult(instanceId, data, 8)
             && hasRemovedOldSlotResult(instanceId, data, 0)
             && hasRemovedOldSlotResult(instanceId, data, 1)
             && hasRemovedOldSlotResult(instanceId, data, 2)
             && hasRemovedOldSlotResult(instanceId, data, 3)
             && hasRemovedOldSlotResult(instanceId, data, 4)
             && hasRemovedOldSlotResult(instanceId, data, 5)
             && hasRemovedOldSlotResult(instanceId, data, 6)
             && hasRemovedOldSlotResult(instanceId, data, 7)
             && hasRemovedOldSlotResult(instanceId, data, 8);
    }

    function hasRemovedOldSlotResult(instanceId, data, index) {
      return !('actualSlotIds' in resource.data)
             || resource.data.actualSlotIds.size() <= index
             || data.actualSlotIds.hasAny([
                  resource.data.actualSlotIds[index]
                ])
             || !existsAfter(
                  /databases/$(database)/documents/workoutInstances/$(instanceId)/slotResults/$(resource.data.actualSlotIds[index])
                );
    }

    function hasValidLegacyActualsChange(instanceId) {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['actuals'])
             || (request.resource.data.actuals is list
                 && request.resource.data.actuals.size() <= 9
                 && !('actualsBySlot' in resource.data)
                 && (!('actualSlotIds' in resource.data)
                     || resource.data.actualSlotIds.size() == 0))
             || (!('actuals' in request.resource.data)
                 && request.resource.data.actualsStorageFormat
                    == 'slotResultsSubcollection'
                 && ((resource.data.actuals is list
                      && resource.data.actuals.size() == 0)
                     || (request.resource.data.actualSlotIds is list
                         && request.resource.data.actualSlotIds.size() > 0
                         && hasCompleteDeclaredSlotResults(
                              instanceId,
                              request.resource.data
                            ))));
    }

    // ── Users ──

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSelf(userId);

      // Exercise notes — private to the owning user
      match /exerciseNotes/{noteId} {
        allow read, write: if isSelf(userId);
      }
    }

    // ── Usernames ──
    // Read: any signed-in user (for username lookup/availability check)
    // Create: signed-in user (transaction enforces uid match)
    // No update/delete: usernames are permanent reservations

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                      && request.resource.data.uid == request.auth.uid;
    }

    // ── Trainer-client relationships ──
    // A deterministic trainerId_athleteId document is the durable roster and
    // authorization boundary. Only the trainer may change its lifecycle.

    match /trainerClientRelationships/{id} {
      allow read: if isSignedIn()
                  && (resource == null
                      || resource.data.trainerId == request.auth.uid
                      || resource.data.athleteId == request.auth.uid);
      allow create: if isSignedIn()
                    && id == relationshipId(
                         request.resource.data.trainerId,
                         request.resource.data.athleteId)
                    && request.resource.data.keys().hasOnly([
                         'trainerId', 'athleteId', 'status', 'startedAt',
                         'endedAt', 'createdAt', 'createdBy', 'updatedAt',
                         'updatedBy', 'deletedAt', 'deletedBy'
                       ])
                    && request.resource.data.trainerId == request.auth.uid
                    && request.resource.data.athleteId != request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.startedAt == request.time
                    && request.resource.data.endedAt == null
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.deletedAt == null
                    && request.resource.data.deletedBy == null;
      allow update: if isSignedIn()
                    && resource.data.trainerId == request.auth.uid
                    && request.resource.data.trainerId
                       == resource.data.trainerId
                    && request.resource.data.athleteId
                       == resource.data.athleteId
                    && request.resource.data.createdAt
                       == resource.data.createdAt
                    && request.resource.data.createdBy
                       == resource.data.createdBy
                    && request.resource.data.deletedAt
                       == resource.data.deletedAt
                    && request.resource.data.deletedBy
                       == resource.data.deletedBy
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'status', 'startedAt', 'endedAt', 'updatedAt',
                           'updatedBy'
                         ])
                    && ((resource.data.status == 'active'
                         && request.resource.data.status == 'ending'
                         && request.resource.data.startedAt
                            == resource.data.startedAt
                         && request.resource.data.endedAt == null)
                        || (resource.data.status == 'ending'
                            && request.resource.data.status == 'ended'
                            && request.resource.data.startedAt
                               == resource.data.startedAt
                            && request.resource.data.endedAt == request.time)
                        || (resource.data.status == 'ended'
                            && request.resource.data.status == 'active'
                            && request.resource.data.startedAt == request.time
                            && request.resource.data.endedAt == null));
      allow delete: if false;
    }

    // ── Feedback ──
    // Authenticated users may submit feedback for themselves. Feedback is
    // intentionally unreadable and immutable through client SDKs; it is
    // reviewed outside the app through privileged Firebase tooling.

    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
                      && request.resource.data.keys().hasOnly([
                           'userId', 'type', 'body', 'appVersion', 'platform',
                           'deviceModel', 'screenName', 'status', 'createdAt',
                           'updatedAt'
                         ])
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.type
                           in ['bug', 'feature', 'general']
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.body.size() <= 5000
                      && request.resource.data.appVersion is string
                      && request.resource.data.appVersion.size() > 0
                      && request.resource.data.appVersion.size() <= 50
                      && request.resource.data.platform
                           in ['android', 'ios', 'web', 'macos', 'windows',
                               'linux']
                      && request.resource.data.deviceModel is string
                      && request.resource.data.deviceModel.size() > 0
                      && request.resource.data.deviceModel.size() <= 200
                      && request.resource.data.screenName is string
                      && request.resource.data.screenName.size() > 0
                      && request.resource.data.screenName.size() <= 200
                      && request.resource.data.status == 'new'
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time;
      allow read, update, delete: if false;
    }

    // ── Exercise Templates ──
    // Logical headers retain signed-in reads while assigned Stage 4 workouts
    // still resolve them. Execution content is immutable in exerciseVersions.

    match /exerciseTemplates/{exerciseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                     && request.resource.data.keys().hasOnly([
                          'ownerId', 'currentVersion', 'createdBy', 'createdAt',
                          'updatedAt', 'updatedBy', 'deletedAt', 'deletedBy',
                          'tags', 'folderId', 'provenance'
                        ])
                     && request.resource.data.ownerId == request.auth.uid
                     && request.resource.data.createdBy == request.auth.uid
                     && request.resource.data.updatedBy == request.auth.uid
                     && hasValidLibraryMetadata(
                         request.resource.data, 'exercise'
                        )
                     && (!('provenance' in request.resource.data)
                        || request.resource.data.provenance == null
                        || (request.resource.data.provenance.copiedBy
                              == request.auth.uid
                            && request.resource.data.provenance.copiedAt
                               == request.time))
                     && request.resource.data.currentVersion == 1
                     && existsAfter(
                          /databases/$(database)/documents/exerciseTemplates/$(exerciseId)/exerciseVersions/1
                        );
      allow update: if isSignedIn()
                    && templateOwner(resource.data) == request.auth.uid
                    && preservesTemplateOwnership()
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'ownerId', 'currentVersion', 'updatedAt',
                           'updatedBy', 'deletedAt', 'deletedBy', 'name',
                           'description', 'instructions', 'videoUrl',
                           'mediaUrls', 'exerciseType',
                           'measurementConfiguration',
                           'gradingConfiguration', 'tags', 'folderId',
                           'provenance'
                         ])
                    && preservesProvenance()
                    && hasValidLibraryMetadataUpdate(
                         request.resource.data, 'exercise'
                       )
                    && ((templateVersion(request.resource.data)
                          == templateVersion(resource.data)
                         && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly([
                                'ownerId', 'updatedAt', 'updatedBy',
                                'deletedAt', 'deletedBy', 'tags', 'folderId'
                              ]))
                        || publishesNextExerciseVersion(exerciseId)
                        || publishesLegacyExerciseEdit(exerciseId))
                     && (templateVersion(resource.data) != 0
                        || templateVersion(request.resource.data) == 0
                        || preservesLegacyExerciseAsVersionOne(exerciseId));
      allow delete: if false;

      match /exerciseVersions/{versionNumber} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && templateOwner(
                           getAfter(
                             /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                           ).data
                         ) == request.auth.uid
                      && request.resource.data.keys().hasOnly([
                           'versionNumber', 'name', 'description',
                           'instructions', 'videoUrl', 'mediaUrls',
                           'exerciseType', 'measurementConfiguration',
                           'gradingConfiguration', 'publishedAt', 'publishedBy'
                         ])
                      && versionNumber
                         == string(request.resource.data.versionNumber)
                      && request.resource.data.versionNumber >= 1
                      && request.resource.data.publishedBy == request.auth.uid
                      && ((!exists(
                             /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                           )
                           && request.resource.data.versionNumber == 1
                           && getAfter(
                                /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                              ).data.currentVersion == 1)
                          || (exists(
                                /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                              )
                              && ((templateVersion(
                                     get(
                                       /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                                     ).data
                                   ) + 1
                                   == request.resource.data.versionNumber
                                   && getAfter(
                                        /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                                      ).data.currentVersion
                                      == request.resource.data.versionNumber)
                                  || (templateVersion(
                                        get(
                                          /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                                        ).data
                                      ) == 0
                                      && request.resource.data.versionNumber
                                         in [1, 2]
                                      && getAfter(
                                           /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                                         ).data.currentVersion == 2))));
        allow update, delete: if false;
      }
    }

    // ── Workout Templates ──
    // Reads remain signed-in during the Stage 4 compatibility window because
    // assigned workouts still resolve live workout documents.
    // Create/update/delete: owner only.

    match /workoutTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                      && request.resource.data.ownerId == request.auth.uid
                      && request.resource.data.createdBy == request.auth.uid
                      && (!('updatedBy' in request.resource.data)
                          || request.resource.data.updatedBy
                             == request.auth.uid)
                      && hasValidLibraryMetadata(
                           request.resource.data, 'workout'
                         )
                      && (!('provenance' in request.resource.data)
                          || request.resource.data.provenance == null
                          || (request.resource.data.provenance.copiedBy
                                == request.auth.uid
                              && request.resource.data.provenance.copiedAt
                                 == request.time));
      allow update: if isSignedIn()
                    && templateOwner(resource.data) == request.auth.uid
                    && preservesTemplateOwnership()
                    && (!('updatedBy' in request.resource.data)
                        || request.resource.data.updatedBy == request.auth.uid)
                    && preservesProvenance()
                    && hasValidLibraryMetadataUpdate(
                         request.resource.data, 'workout'
                       )
                    && (templateVersion(request.resource.data)
                          == templateVersion(resource.data)
                        || publishesNextWorkoutVersion(templateId));
      allow delete: if false;

      // Workout template versions (subcollection)
      match /workoutTemplateVersions/{versionNumber} {
        allow read: if isSignedIn()
                    && (!('publishState' in resource.data)
                        || resource.data.publishState == 'published'
                        || resource.data.ownerId == request.auth.uid);
        allow create: if isSignedIn()
                       && templateOwner(
                           get(/databases/$(database)/documents/workoutTemplates/$(templateId)).data)
                          == request.auth.uid
                       && versionNumber
                          == string(request.resource.data.versionNumber)
                       && request.resource.data.versionNumber >= 1
                       && !('exercises' in request.resource.data)
                       && ((request.resource.data.storageFormat
                              == 'exercisePrescriptionSubcollection'
                            && request.resource.data.prescriptionCount is int
                            && request.resource.data.prescriptionCount >= 0
                            && request.resource.data.prescriptionCount <= 9
                            && getAfter(
                                 /databases/$(database)/documents/workoutTemplates/$(templateId)
                               ).data.currentVersion
                               == request.resource.data.versionNumber)
                           || (request.resource.data.storageFormat
                                == 'typedWorkoutBlocksV1'
                               && hasValidTypedWorkoutVersion(
                                    request.resource.data
                                  )
                               && request.resource.data.ownerId
                                  == request.auth.uid
                               && request.resource.data.publishState == 'draft'
                               && getAfter(
                                    /databases/$(database)/documents/workoutTemplates/$(templateId)
                                  ).data.currentVersion
                                  == templateVersion(
                                       get(
                                         /databases/$(database)/documents/workoutTemplates/$(templateId)
                                       ).data
                                     )))
                       && templateVersion(
                            get(
                              /databases/$(database)/documents/workoutTemplates/$(templateId)
                            ).data
                          ) + 1 == request.resource.data.versionNumber;
        allow update: if isSignedIn()
                      && resource.data.storageFormat
                         == 'typedWorkoutBlocksV1'
                      && resource.data.ownerId == request.auth.uid
                      && ((resource.data.publishState == 'draft'
                           && request.resource.data.publishState == 'published'
                           && request.resource.data.diff(resource.data)
                                .affectedKeys().hasOnly(['publishState'])
                           && getAfter(
                                /databases/$(database)/documents/workoutTemplates/$(templateId)
                              ).data.currentVersion
                              == request.resource.data.versionNumber
                           && hasAllTypedSlotChildren(
                                templateId,
                                versionNumber,
                                request.resource.data
                              ))
                          || (resource.data.publishState == 'draft'
                              && request.resource.data.publishState
                                 == 'deleting'
                              && request.resource.data.diff(resource.data)
                                   .affectedKeys().hasOnly(['publishState'])
                              && templateVersion(
                                   get(
                                     /databases/$(database)/documents/workoutTemplates/$(templateId)
                                   ).data
                                 ) + 1
                                 == resource.data.versionNumber)
                          || (resource.data.publishState == 'deleting'
                              && request.resource.data.publishState
                                 == 'deleting'
                              && 'blocksCleared' in request.resource.data
                              && request.resource.data.blocksCleared == true
                              && request.resource.data.diff(resource.data)
                                   .affectedKeys().hasOnly(['blocksCleared'])
                              && hasNoTypedBlockChildren(
                                   templateId,
                                   versionNumber,
                                   request.resource.data
                                 ))
                          || (resource.data.publishState == 'deleting'
                              && request.resource.data.publishState
                                 == 'deleting'
                              && 'slotsCleared' in request.resource.data
                              && request.resource.data.slotsCleared == true
                              && request.resource.data.diff(resource.data)
                                   .affectedKeys().hasOnly(['slotsCleared'])
                              && hasNoTypedSlotChildren(
                                   templateId,
                                   versionNumber,
                                   request.resource.data
                                 )));
        allow delete: if isSignedIn()
                      && resource.data.storageFormat
                         == 'typedWorkoutBlocksV1'
                      && resource.data.publishState == 'deleting'
                      && resource.data.ownerId == request.auth.uid
                      && 'blocksCleared' in resource.data
                      && resource.data.blocksCleared == true
                      && 'slotsCleared' in resource.data
                      && resource.data.slotsCleared == true
                      && templateVersion(
                           get(
                             /databases/$(database)/documents/workoutTemplates/$(templateId)
                           ).data
                         ) + 1 == resource.data.versionNumber;

        match /workoutBlocks/{blockId} {
          allow read: if canReadWorkoutVersionChild(
                           templateId,
                           versionNumber
                         );
          allow create: if isSignedIn()
                         && blockId == request.resource.data.blockId
                         && hasValidWorkoutBlock(request.resource.data)
                         && !exists(
                             /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                           )
                         && getAfter(
                              /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                            ).data.storageFormat == 'typedWorkoutBlocksV1'
                         && getAfter(
                              /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                            ).data.publishState == 'draft'
                         && getAfter(
                              /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                            ).data.ownerId == request.auth.uid
                         && request.resource.data
                            == getAfter(
                                /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                              ).data.blocks[request.resource.data.sortOrder]
                         && hasValidBlockManifestRange(
                              getAfter(
                                /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                              ).data,
                              request.resource.data
                            );
          allow update: if false;
          allow delete: if canDeleteDraftWorkoutVersionChild(
                             templateId,
                             versionNumber
                           );
        }

        match /exerciseSlots/{slotId} {
          allow read: if canReadWorkoutVersionChild(
                           templateId,
                           versionNumber
                         );
          allow create: if isSignedIn()
                         && slotId == request.resource.data.slotId
                         && hasValidWorkoutSlot(request.resource.data)
                         && isOwnedExerciseVersion(
                              request.resource.data.exerciseId,
                              request.resource.data.exerciseVersion
                            )
                         && !exists(
                             /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                           )
                         && getAfter(
                              /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                            ).data.storageFormat == 'typedWorkoutBlocksV1'
                         && getAfter(
                              /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                            ).data.publishState == 'draft'
                         && getAfter(
                              /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                            ).data.ownerId == request.auth.uid
                         && request.resource.data
                            == getAfter(
                                /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                              ).data.slots[request.resource.data.slotOrder]
                         && getAfter(
                              /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                            ).data.slotIds[request.resource.data.slotOrder]
                            == slotId
                         && request.resource.data.blockSortOrder
                            < getAfter(
                                /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                              ).data.blockCount
                         && getAfter(
                              /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                            ).data.blocks[
                              request.resource.data.blockSortOrder
                            ].blockId == request.resource.data.blockId
                         && request.resource.data.sortOrder
                            < getAfter(
                                /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                              ).data.blocks[
                                request.resource.data.blockSortOrder
                              ].slotCount
                         && getAfter(
                              /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                            ).data.blocks[
                              request.resource.data.blockSortOrder
                            ].slotIds[request.resource.data.sortOrder]
                            == slotId
                         && request.resource.data.slotOrder
                            == getAfter(
                                 /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                               ).data.blocks[
                                 request.resource.data.blockSortOrder
                               ].slotStartOrder
                               + request.resource.data.sortOrder;
          allow update: if false;
          allow delete: if canDeleteDraftWorkoutVersionChild(
                             templateId,
                             versionNumber
                           );
        }

        match /exercisePrescriptions/{sortOrder} {
          allow read: if isSignedIn();
          allow create: if isSignedIn()
                         && templateOwner(
                             get(
                               /databases/$(database)/documents/workoutTemplates/$(templateId)
                             ).data
                           ) == request.auth.uid
                         && request.resource.data.keys().hasOnly([
                             'exerciseId', 'exerciseVersion', 'sortOrder',
                             'exerciseName', 'prescription'
                           ])
                         && sortOrder == string(request.resource.data.sortOrder)
                         && request.resource.data.sortOrder >= 0
                         && request.resource.data.exerciseVersion >= 1
                         && isOwnedExerciseVersion(
                             request.resource.data.exerciseId,
                             request.resource.data.exerciseVersion
                           )
                         && !exists(
                             /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                           )
                         && versionNumber == string(
                             getAfter(
                               /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                             ).data.versionNumber
                           )
                         && request.resource.data.sortOrder
                           < getAfter(
                               /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                             ).data.prescriptionCount;
          allow update, delete: if false;
        }
      }
    }

    // ── Programs ──
    // Read: owner, or actively enrolled athlete
    // Create: self (ownerId must match auth uid)
    // Update/delete: owner only

    match /programs/{programId} {
      allow read: if isSignedIn()
                    && (resource.data.ownerId == request.auth.uid
                        || isEnrolledActive(programId));
      allow create: if isSignedIn()
                      && request.resource.data.ownerId == request.auth.uid
                      && request.resource.data.createdBy == request.auth.uid
                      && (!('updatedBy' in request.resource.data)
                          || request.resource.data.updatedBy
                             == request.auth.uid)
                      && hasValidLibraryMetadata(
                           request.resource.data, 'program'
                         )
                      && (!('provenance' in request.resource.data)
                          || request.resource.data.provenance == null
                          || (request.resource.data.provenance.copiedBy
                                == request.auth.uid
                              && request.resource.data.provenance.copiedAt
                                 == request.time));
      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.createdBy == resource.data.createdBy
                    && (!('updatedBy' in request.resource.data)
                        || request.resource.data.updatedBy == request.auth.uid)
                    && preservesProvenance()
                    && hasValidLibraryMetadataUpdate(
                         request.resource.data, 'program'
                       )
                    && (templateVersion(request.resource.data)
                          == templateVersion(resource.data)
                        || publishesNextProgramVersion(programId));
      allow delete: if false;

      // Program versions (subcollection)
      match /programVersions/{versionNumber} {
        allow read: if isSignedIn()
                      && (get(/databases/$(database)/documents/programs/$(programId)).data.ownerId
                          == request.auth.uid
                          || isEnrolledActive(programId));
        allow create: if isSignedIn()
                       && get(
                            /databases/$(database)/documents/programs/$(programId)
                          ).data.ownerId == request.auth.uid
                       && versionNumber
                          == string(request.resource.data.versionNumber)
                       && request.resource.data.versionNumber >= 1
                       && templateVersion(
                            get(
                              /databases/$(database)/documents/programs/$(programId)
                            ).data
                          ) + 1 == request.resource.data.versionNumber
                       && getAfter(
                            /databases/$(database)/documents/programs/$(programId)
                          ).data.currentVersion
                          == request.resource.data.versionNumber;
        allow update, delete: if false;
      }
    }

    // ── Library Folders ──
    // Owner- and template-type-scoped folders. The legacy collection name is
    // retained so existing program folder IDs remain stable.
    // Read: owner only.
    // Create: self (ownerId must match auth uid).
    // Update/delete: owner only.

    match /programFolders/{folderId} {
      allow read: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
                      && request.resource.data.keys().hasOnly([
                           'ownerId', 'itemType', 'name', 'createdBy',
                           'createdAt', 'updatedBy', 'updatedAt', 'deletedAt',
                           'deletedBy'
                         ])
                      && request.resource.data.ownerId == request.auth.uid
                      && (!('createdBy' in request.resource.data)
                          || request.resource.data.createdBy
                             == request.auth.uid)
                      && (!('updatedBy' in request.resource.data)
                          || request.resource.data.updatedBy
                             == request.auth.uid)
                      && (!('itemType' in request.resource.data)
                          || request.resource.data.itemType
                             in ['exercise', 'workout', 'program'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0;
      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && (!('createdBy' in resource.data)
                        || request.resource.data.createdBy
                           == resource.data.createdBy)
                    && (!('updatedBy' in request.resource.data)
                        || request.resource.data.updatedBy == request.auth.uid)
                    && ((!('itemType' in request.resource.data)
                         && !('itemType' in resource.data))
                        || request.resource.data.itemType
                           == libraryFolderType(resource.data))
                    && ((request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly([
                             'itemType', 'name', 'updatedBy', 'updatedAt'
                           ])
                         && ((!('deletedAt' in resource.data)
                              && !('deletedAt' in request.resource.data))
                             || request.resource.data.deletedAt
                                == resource.data.deletedAt))
                        || (request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly([
                                'itemType', 'updatedBy', 'updatedAt',
                                'deletedAt', 'deletedBy'
                              ])
                            && request.resource.data.deletedAt == request.time
                            && request.resource.data.deletedBy
                               == request.auth.uid));
      allow delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && (!('itemType' in resource.data)
                        || (resource.data.deletedAt != null
                            && resource.data.deletedBy == request.auth.uid));
    }

    // ── Enrollments ──
    // Read: program owner or the enrolled athlete.
    //   resource == null allows a get() of a non-existent enrollment to
    //   return "not found" instead of permission-denied — required by the
    //   isEnrolled() check when adding a not-yet-enrolled athlete. For
    //   queries (list) resource is always populated, so this does not widen
    //   query exposure.
    // Create/update: program owner only (and program must be assignable)
    // No hard delete

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn()
                    && (resource == null
                        || resource.data.athleteId == request.auth.uid
                        || resource.data.addedBy == request.auth.uid);
      allow create: if isSignedIn()
                      && isProgramOwner(request.resource.data.programId)
                      && isProgramAssignable(request.resource.data.programId)
                      && (request.resource.data.athleteId == request.auth.uid
                          || hasActiveTrainerClientRelationship(
                               request.auth.uid,
                               request.resource.data.athleteId))
                      && request.resource.data.addedBy == request.auth.uid;
      allow update: if isSignedIn()
                      && isProgramOwner(resource.data.programId)
                      && isProgramAssignable(resource.data.programId)
                      && request.resource.data.programId
                         == resource.data.programId
                      && request.resource.data.athleteId
                         == resource.data.athleteId
                      && request.resource.data.addedBy
                         == resource.data.addedBy
                      && (request.resource.data.status != 'active'
                          || resource.data.athleteId == request.auth.uid
                          || hasActiveTrainerClientRelationship(
                               request.auth.uid,
                               resource.data.athleteId));
    }

    // ── Athlete Program Instances ──
    // Athlete-owned materialized program lifecycle. Trainers may create and
    // manage linked instances only while the roster relationship is active.

    match /athleteProgramInstances/{instanceId} {
      allow read: if isSignedIn()
                  && (resource.data.athleteOwnerId == request.auth.uid
                      || (resource.data.assigningTrainerId == request.auth.uid
                          && hasManageableTrainerClientRelationship(
                               request.auth.uid,
                               resource.data.athleteOwnerId)));
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly([
                         'athleteOwnerId', 'assigningTrainerId',
                         'sourceProgramId', 'sourceProgramVersion',
                         'relationshipMode', 'startDate', 'expectedEndDate',
                         'workoutCount', 'status', 'linkedAt', 'unlinkedAt',
                         'unlinkReason', 'materializationKey', 'createdAt',
                         'createdBy', 'updatedAt', 'updatedBy', 'deletedAt',
                         'deletedBy'
                       ])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.sourceProgramVersion is int
                    && request.resource.data.sourceProgramVersion >= 1
                    && request.resource.data.startDate is string
                    && request.resource.data.expectedEndDate is string
                    && request.resource.data.workoutCount is int
                    && request.resource.data.workoutCount >= 1
                    && request.resource.data.status
                         in ['active', 'completed', 'cancelled']
                    && request.resource.data.relationshipMode
                         in ['subscribed', 'copied']
                    && request.resource.data.unlinkedAt == null
                    && request.resource.data.unlinkReason == null
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.deletedAt == null
                    && request.resource.data.deletedBy == null
                    && ((request.resource.data.assigningTrainerId
                           == request.auth.uid
                         && request.resource.data.status == 'active'
                         && isProgramOwner(
                              request.resource.data.sourceProgramId
                            )
                         && ((request.resource.data.athleteOwnerId
                                == request.auth.uid
                              && request.resource.data.relationshipMode
                                 == 'copied'
                              && request.resource.data.linkedAt == null)
                             || (request.resource.data.athleteOwnerId
                                   != request.auth.uid
                                 && hasActiveTrainerClientRelationship(
                                      request.auth.uid,
                                      request.resource.data.athleteOwnerId
                                    )
                                 && ((request.resource.data.relationshipMode
                                        == 'subscribed'
                                      && request.resource.data.linkedAt
                                         == request.time)
                                     || (request.resource.data.relationshipMode
                                           == 'copied'
                                         && request.resource.data.linkedAt
                                            == null)))))
                        || (request.resource.data.athleteOwnerId
                              == request.auth.uid
                            && request.resource.data.relationshipMode
                               == 'copied'
                            && request.resource.data.linkedAt == null
                            && request.resource.data.assigningTrainerId
                               == get(
                                    /databases/$(database)/documents/programs/$(request.resource.data.sourceProgramId)
                                  ).data.ownerId));
      allow update: if isSignedIn()
                    && request.resource.data.athleteOwnerId
                         == resource.data.athleteOwnerId
                    && request.resource.data.assigningTrainerId
                         == resource.data.assigningTrainerId
                    && request.resource.data.sourceProgramId
                         == resource.data.sourceProgramId
                    && request.resource.data.sourceProgramVersion
                         == resource.data.sourceProgramVersion
                    && request.resource.data.startDate
                         == resource.data.startDate
                    && request.resource.data.expectedEndDate
                         == resource.data.expectedEndDate
                    && request.resource.data.workoutCount
                         == resource.data.workoutCount
                    && request.resource.data.createdAt
                         == resource.data.createdAt
                    && request.resource.data.createdBy
                         == resource.data.createdBy
                    && request.resource.data.materializationKey
                         == resource.data.materializationKey
                    && request.resource.data.deletedAt
                         == resource.data.deletedAt
                    && request.resource.data.deletedBy
                         == resource.data.deletedBy
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.updatedBy == request.auth.uid
                    && ((resource.data.athleteOwnerId == request.auth.uid
                         && resource.data.status == 'active'
                         && resource.data.relationshipMode == 'subscribed'
                         && request.resource.data.relationshipMode == 'copied'
                         && request.resource.data.unlinkedAt == request.time
                         && request.resource.data.unlinkReason is string
                         && request.resource.data.unlinkReason.size() > 0
                         && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly([
                                'relationshipMode', 'unlinkedAt',
                                'unlinkReason', 'updatedAt', 'updatedBy'
                              ]))
                        || (resource.data.assigningTrainerId
                              == request.auth.uid
                            && resource.data.relationshipMode == 'subscribed'
                            && request.resource.data.relationshipMode
                               == 'copied'
                            && request.resource.data.unlinkedAt == request.time
                            && request.resource.data.unlinkReason
                               == 'relationshipEnded'
                            && getAfter(
                                 /databases/$(database)/documents/trainerClientRelationships/$(relationshipId(request.auth.uid, resource.data.athleteOwnerId))
                               ).data.status in ['ending', 'ended']
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys().hasOnly([
                                   'relationshipMode', 'unlinkedAt',
                                   'unlinkReason', 'updatedAt', 'updatedBy'
                                 ]))
                        || (((request.resource.data.status == 'completed'
                              && resource.data.status == 'active'
                              && (resource.data.athleteOwnerId
                                    == request.auth.uid
                                  || (resource.data.assigningTrainerId
                                        == request.auth.uid
                                      && hasActiveTrainerClientRelationship(
                                           request.auth.uid,
                                           resource.data.athleteOwnerId
                                         ))))
                             || (request.resource.data.status == 'cancelled'
                                 && resource.data.status == 'active'
                                 && (resource.data.athleteOwnerId
                                       == request.auth.uid
                                     || (resource.data.assigningTrainerId
                                           == request.auth.uid
                                         && hasActiveTrainerClientRelationship(
                                              request.auth.uid,
                                              resource.data.athleteOwnerId
                                            )))))
                            && request.resource.data.relationshipMode
                               == resource.data.relationshipMode
                            && request.resource.data.linkedAt
                               == resource.data.linkedAt
                            && request.resource.data.unlinkedAt
                               == resource.data.unlinkedAt
                            && request.resource.data.unlinkReason
                               == resource.data.unlinkReason
                            && request.resource.data.status
                               in ['active', 'completed', 'cancelled']
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys().hasOnly([
                                   'status', 'updatedAt', 'updatedBy'
                                 ])));
      allow delete: if false;
    }

    // ── Workout Instances ──
    // Read: athlete, assigning user (legacy), or immutable program owner.
    // Create: program owner assigns workouts, or an actively enrolled athlete
    //   assigns a workout to themselves.
    // Update: athlete can complete/edit own; owner can edit scheduling
    //   fields only (reschedule, swap workout, cancel) — never completion
    //   data (rpe, duration, notes, actuals, load), which is athlete-only.

    match /workoutInstances/{instanceId} {
      allow read: if isSignedIn()
                    && canReadWorkout(resource.data);
      allow create: if isSignedIn()
                      && request.resource.data.assignedBy == request.auth.uid
                      && (!('actuals' in request.resource.data)
                          || (request.resource.data.actuals is list
                              && request.resource.data.actuals.size() == 0))
                      && (!('actualsBySlot' in request.resource.data)
                          || (request.resource.data.actualsBySlot is map
                              && request.resource.data.actualsBySlot.size()
                                 == 0))
                      && (!('actualSlotIds' in request.resource.data)
                          || (request.resource.data.actualSlotIds is list
                              && request.resource.data.actualSlotIds.size()
                                 == 0))
                      && hasValidProgramOwner(request.resource.data)
                      && hasValidProgramInstanceReference(
                           request.resource.data
                         )
                      && hasActiveRelationshipForProgram(request.resource.data)
                      && (isProgramOwner(request.resource.data.programId)
                          || (request.resource.data.athleteId
                                == request.auth.uid
                              && isEnrolledActive(
                                   request.resource.data.programId)));
      allow update: if isSignedIn()
                      && preservesProgramOwner()
                      && hasValidLegacyActualsChange(instanceId)
                      && (!request.resource.data.diff(resource.data)
                            .affectedKeys().hasAny(['actualsBySlot'])
                          || !('actualsBySlot' in request.resource.data))
                      && (!request.resource.data.diff(resource.data)
                            .affectedKeys().hasAny([
                              'actualSlotIds', 'actualsStorageFormat'
                            ])
                          || hasCompleteDeclaredSlotResults(
                               instanceId,
                               request.resource.data
                             ))
                      && ((resource.data.athleteId == request.auth.uid
                           && (isAthleteCompletionUpdate()
                               || isProgramOwnerBackfill()
                               || isProgramInstanceBackfill()
                               || isProgramInstanceModeSync()
                               || (canManageWorkoutSchedule(resource.data)
                                   && isAthleteSchedulingUpdate())))
                          || (canTrainerManageWorkoutSchedule(resource.data)
                              && isOwnerSchedulingUpdate())
                          || isEndingRelationshipModeSync());
      allow delete: if isSignedIn()
                      && resource.data.status == 'scheduled'
                      && isCurrentOrFutureWorkout(resource.data)
                      && canDeleteWorkout(resource.data);

      match /slotResults/{slotId} {
        allow read: if isSignedIn()
                    && canReadWorkout(workoutInstanceData(instanceId));
        allow create, update: if isSignedIn()
                              && getAfter(
                                   /databases/$(database)/documents/workoutInstances/$(instanceId)
                                 ).data.athleteId == request.auth.uid
                              && workoutInstanceData(instanceId).status
                                 == 'scheduled'
                              && getAfter(
                                   /databases/$(database)/documents/workoutInstances/$(instanceId)
                                 ).data.status == 'completed'
                              && getAfter(
                                   /databases/$(database)/documents/workoutInstances/$(instanceId)
                                 ).data.actualsStorageFormat
                                 == 'slotResultsSubcollection'
                              && getAfter(
                                   /databases/$(database)/documents/workoutInstances/$(instanceId)
                                 ).data.actualSlotIds.hasAny([slotId])
                              && getAfter(
                                   /databases/$(database)/documents/workoutInstances/$(instanceId)
                                 ).data.updatedAt == request.time
                              && hasValidSlotResult(request.resource.data)
                              && hasValidResultSlot(
                                   instanceId,
                                   slotId,
                                   request.resource.data
                                 );
        allow delete: if isSignedIn()
                      && canManageWorkoutSchedule(
                           workoutInstanceData(instanceId)
                         )
                      && (!existsAfter(
                            /databases/$(database)/documents/workoutInstances/$(instanceId)
                          )
                          || !getAfter(
                               /databases/$(database)/documents/workoutInstances/$(instanceId)
                             ).data.actualSlotIds.hasAny([slotId]));
      }
    }
  }
}
