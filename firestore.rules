rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isProgramOwner(programId) {
      return isSignedIn()
             && get(/databases/$(database)/documents/programs/$(programId)).data.ownerId
                == request.auth.uid;
    }

    function isEnrolledActive(programId) {
      let enrollmentId = programId + '_' + request.auth.uid;
      return isSignedIn()
             && exists(/databases/$(database)/documents/enrollments/$(enrollmentId))
             && get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.status
                == 'active';
    }

    function relationshipId(trainerId, athleteId) {
      return trainerId + '_' + athleteId;
    }

    function hasActiveTrainerClientRelationship(trainerId, athleteId) {
      let id = relationshipId(trainerId, athleteId);
      return isSignedIn()
             && exists(/databases/$(database)/documents/trainerClientRelationships/$(id))
             && get(/databases/$(database)/documents/trainerClientRelationships/$(id)).data.status
                == 'active';
    }

    function templateOwner(data) {
      return 'ownerId' in data ? data.ownerId : data.createdBy;
    }

    function preservesTemplateOwnership() {
      return request.resource.data.createdBy == resource.data.createdBy
             && request.resource.data.ownerId == templateOwner(resource.data);
    }

    function templateVersion(data) {
      return 'currentVersion' in data ? data.currentVersion : 0;
    }

    function libraryFolderType(data) {
      return 'itemType' in data ? data.itemType : 'program';
    }

    function hasValidTags(data) {
      return !('tags' in data)
             || (data.tags is list && data.tags.size() <= 20);
    }

    function hasValidProvenance(data) {
      return !('provenance' in data)
             || data.provenance == null
             || (data.provenance is map
                 && data.provenance.keys().hasOnly([
                      'sourceTemplateId', 'sourceOwnerId', 'sourceVersion',
                      'copiedAt', 'copiedBy'
                    ])
                 && data.provenance.sourceTemplateId is string
                 && data.provenance.sourceTemplateId.size() > 0
                 && data.provenance.sourceOwnerId is string
                 && data.provenance.sourceOwnerId.size() > 0
                 && data.provenance.sourceVersion is int
                 && data.provenance.sourceVersion >= 0
                 && data.provenance.copiedAt is timestamp
                 && data.provenance.copiedBy is string
                 && data.provenance.copiedBy.size() > 0);
    }

    function hasValidProvenanceSource(data, itemType) {
      return !('provenance' in data)
             || data.provenance == null
             || (itemType == 'exercise'
                 && exists(
                      /databases/$(database)/documents/exerciseTemplates/$(data.provenance.sourceTemplateId)
                    )
                 && data.provenance.sourceOwnerId == templateOwner(
                      get(
                        /databases/$(database)/documents/exerciseTemplates/$(data.provenance.sourceTemplateId)
                      ).data
                    )
                 && ((templateVersion(
                        get(
                          /databases/$(database)/documents/exerciseTemplates/$(data.provenance.sourceTemplateId)
                        ).data
                      ) == 0
                      && data.provenance.sourceVersion == 1)
                     || exists(
                          /databases/$(database)/documents/exerciseTemplates/$(data.provenance.sourceTemplateId)/exerciseVersions/$(data.provenance.sourceVersion)
                        )))
             || (itemType == 'workout'
                 && exists(
                      /databases/$(database)/documents/workoutTemplates/$(data.provenance.sourceTemplateId)
                    )
                 && data.provenance.sourceOwnerId == templateOwner(
                      get(
                        /databases/$(database)/documents/workoutTemplates/$(data.provenance.sourceTemplateId)
                      ).data
                    )
                 && ((templateVersion(
                        get(
                          /databases/$(database)/documents/workoutTemplates/$(data.provenance.sourceTemplateId)
                        ).data
                      ) == 0
                      && data.provenance.sourceVersion == 0)
                     || exists(
                          /databases/$(database)/documents/workoutTemplates/$(data.provenance.sourceTemplateId)/workoutTemplateVersions/$(data.provenance.sourceVersion)
                        )))
             || (itemType == 'program'
                 && exists(
                      /databases/$(database)/documents/programs/$(data.provenance.sourceTemplateId)
                    )
                 && data.provenance.sourceOwnerId
                    == get(
                         /databases/$(database)/documents/programs/$(data.provenance.sourceTemplateId)
                       ).data.ownerId
                 && ((templateVersion(
                        get(
                          /databases/$(database)/documents/programs/$(data.provenance.sourceTemplateId)
                        ).data
                      ) == 0
                      && data.provenance.sourceVersion == 0)
                     || exists(
                          /databases/$(database)/documents/programs/$(data.provenance.sourceTemplateId)/programVersions/$(data.provenance.sourceVersion)
                        )));
    }

    function preservesProvenance() {
      return (!('provenance' in resource.data)
              && (!('provenance' in request.resource.data)
                  || request.resource.data.provenance == null))
             || (('provenance' in resource.data)
                 && ('provenance' in request.resource.data)
                 && request.resource.data.provenance
                    == resource.data.provenance);
    }

    function hasValidLibraryFolder(data, itemType) {
      return !('folderId' in data)
             || data.folderId == null
             || (data.folderId is string
                 && data.folderId.size() > 0
                 && exists(
                      /databases/$(database)/documents/programFolders/$(data.folderId)
                    )
                 && get(
                      /databases/$(database)/documents/programFolders/$(data.folderId)
                    ).data.ownerId == request.auth.uid
                 && (!('deletedAt' in get(
                        /databases/$(database)/documents/programFolders/$(data.folderId)
                      ).data)
                     || get(
                          /databases/$(database)/documents/programFolders/$(data.folderId)
                        ).data.deletedAt == null)
                 && libraryFolderType(
                      get(
                        /databases/$(database)/documents/programFolders/$(data.folderId)
                      ).data
                    ) == itemType);
    }

    function hasValidLibraryMetadata(data, itemType) {
      return hasValidTags(data)
             && hasValidProvenance(data)
             && hasValidProvenanceSource(data, itemType)
             && hasValidLibraryFolder(data, itemType);
    }

    function hasValidLibraryMetadataUpdate(data, itemType) {
      return hasValidTags(data)
             && hasValidProvenance(data)
             && (!request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['folderId'])
                 || hasValidLibraryFolder(data, itemType));
    }

    function publishesNextExerciseVersion(templateId) {
      let nextVersion = templateVersion(resource.data) + 1;
      return request.resource.data.currentVersion == nextVersion
             && existsAfter(
               /databases/$(database)/documents/exerciseTemplates/$(templateId)/exerciseVersions/$(nextVersion)
             );
    }

    function publishesLegacyExerciseEdit(templateId) {
      return templateVersion(resource.data) == 0
             && request.resource.data.currentVersion == 2
             && existsAfter(
               /databases/$(database)/documents/exerciseTemplates/$(templateId)/exerciseVersions/1
             )
             && existsAfter(
               /databases/$(database)/documents/exerciseTemplates/$(templateId)/exerciseVersions/2
             );
    }

    function preservesLegacyExerciseAsVersionOne(templateId) {
      let version = getAfter(
        /databases/$(database)/documents/exerciseTemplates/$(templateId)/exerciseVersions/1
      ).data;
      return !('name' in request.resource.data)
             && !('description' in request.resource.data)
             && !('instructions' in request.resource.data)
             && !('videoUrl' in request.resource.data)
             && !('mediaUrls' in request.resource.data)
             && !('exerciseType' in request.resource.data)
             && !('measurementConfiguration' in request.resource.data)
             && !('gradingConfiguration' in request.resource.data)
             && version.name
                == ('name' in resource.data ? resource.data.name : '')
             && version.description
                == ('description' in resource.data
                    ? resource.data.description : '')
             && version.instructions
                == ('instructions' in resource.data
                    ? resource.data.instructions : '')
             && version.videoUrl
                == ('videoUrl' in resource.data ? resource.data.videoUrl : null)
             && version.mediaUrls
                == ('mediaUrls' in resource.data ? resource.data.mediaUrls : [])
             && version.exerciseType
                == ('exerciseType' in resource.data
                    ? resource.data.exerciseType : 'other')
             && version.measurementConfiguration
                == ('measurementConfiguration' in resource.data
                    ? resource.data.measurementConfiguration
                    : {'primary': 'repetitions', 'secondary': []})
             && version.gradingConfiguration
                == ('gradingConfiguration' in resource.data
                    ? resource.data.gradingConfiguration : null);
    }

    function publishesNextWorkoutVersion(templateId) {
      let nextVersion = templateVersion(resource.data) + 1;
      return request.resource.data.currentVersion == nextVersion
             && existsAfter(
               /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(nextVersion)
             );
    }

    function publishesNextProgramVersion(programId) {
      let nextVersion = templateVersion(resource.data) + 1;
      return request.resource.data.currentVersion == nextVersion
             && existsAfter(
                  /databases/$(database)/documents/programs/$(programId)/programVersions/$(nextVersion)
                );
    }

    function isOwnedExerciseVersion(exerciseId, versionNumber) {
      let exercise = get(
        /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
      ).data;
      return templateOwner(exercise) == request.auth.uid
             && ((templateVersion(exercise) == 0 && versionNumber == 1)
                 || exists(
                      /databases/$(database)/documents/exerciseTemplates/$(exerciseId)/exerciseVersions/$(versionNumber)
                    ));
    }

    function isProgramAssignable(programId) {
      return get(/databases/$(database)/documents/programs/$(programId)).data.type
             == 'assignable';
    }

    function hasValidProgramOwner(data) {
      return data.programOwnerId
             == get(/databases/$(database)/documents/programs/$(data.programId))
                 .data.ownerId;
    }

    function hasActiveRelationshipForProgram(data) {
      let ownerId =
        get(/databases/$(database)/documents/programs/$(data.programId)).data.ownerId;
      return ownerId == data.athleteId
             || hasActiveTrainerClientRelationship(ownerId, data.athleteId);
    }

    function preservesProgramOwner() {
      return (!('programOwnerId' in resource.data)
              && (!('programOwnerId' in request.resource.data)
                 || hasValidProgramOwner(request.resource.data)))
             || (('programOwnerId' in resource.data)
                && request.resource.data.programOwnerId
                   == resource.data.programOwnerId);
    }

    // ── Users ──

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSelf(userId);

      // Exercise notes — private to the owning user
      match /exerciseNotes/{noteId} {
        allow read, write: if isSelf(userId);
      }
    }

    // ── Usernames ──
    // Read: any signed-in user (for username lookup/availability check)
    // Create: signed-in user (transaction enforces uid match)
    // No update/delete: usernames are permanent reservations

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                      && request.resource.data.uid == request.auth.uid;
    }

    // ── Trainer-client relationships ──
    // A deterministic trainerId_athleteId document is the durable roster and
    // authorization boundary. Only the trainer may change its lifecycle.

    match /trainerClientRelationships/{id} {
      allow read: if isSignedIn()
                  && (resource.data.trainerId == request.auth.uid
                      || resource.data.athleteId == request.auth.uid);
      allow create: if isSignedIn()
                    && id == relationshipId(
                         request.resource.data.trainerId,
                         request.resource.data.athleteId)
                    && request.resource.data.keys().hasOnly([
                         'trainerId', 'athleteId', 'status', 'startedAt',
                         'endedAt', 'createdAt', 'createdBy', 'updatedAt',
                         'updatedBy', 'deletedAt', 'deletedBy'
                       ])
                    && request.resource.data.trainerId == request.auth.uid
                    && request.resource.data.athleteId != request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.startedAt == request.time
                    && request.resource.data.endedAt == null
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.deletedAt == null
                    && request.resource.data.deletedBy == null;
      allow update: if isSignedIn()
                    && resource.data.trainerId == request.auth.uid
                    && request.resource.data.trainerId
                       == resource.data.trainerId
                    && request.resource.data.athleteId
                       == resource.data.athleteId
                    && request.resource.data.createdAt
                       == resource.data.createdAt
                    && request.resource.data.createdBy
                       == resource.data.createdBy
                    && request.resource.data.deletedAt
                       == resource.data.deletedAt
                    && request.resource.data.deletedBy
                       == resource.data.deletedBy
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'status', 'startedAt', 'endedAt', 'updatedAt',
                           'updatedBy'
                         ])
                    && ((resource.data.status == 'active'
                         && request.resource.data.status == 'ended'
                         && request.resource.data.startedAt
                            == resource.data.startedAt
                         && request.resource.data.endedAt == request.time)
                        || (resource.data.status == 'ended'
                            && request.resource.data.status == 'active'
                            && request.resource.data.startedAt == request.time
                            && request.resource.data.endedAt == null));
      allow delete: if false;
    }

    // ── Feedback ──
    // Authenticated users may submit feedback for themselves. Feedback is
    // intentionally unreadable and immutable through client SDKs; it is
    // reviewed outside the app through privileged Firebase tooling.

    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
                      && request.resource.data.keys().hasOnly([
                           'userId', 'type', 'body', 'appVersion', 'platform',
                           'deviceModel', 'screenName', 'status', 'createdAt',
                           'updatedAt'
                         ])
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.type
                           in ['bug', 'feature', 'general']
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.body.size() <= 5000
                      && request.resource.data.appVersion is string
                      && request.resource.data.appVersion.size() > 0
                      && request.resource.data.appVersion.size() <= 50
                      && request.resource.data.platform
                           in ['android', 'ios', 'web', 'macos', 'windows',
                               'linux']
                      && request.resource.data.deviceModel is string
                      && request.resource.data.deviceModel.size() > 0
                      && request.resource.data.deviceModel.size() <= 200
                      && request.resource.data.screenName is string
                      && request.resource.data.screenName.size() > 0
                      && request.resource.data.screenName.size() <= 200
                      && request.resource.data.status == 'new'
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time;
      allow read, update, delete: if false;
    }

    // ── Exercise Templates ──
    // Logical headers retain signed-in reads while assigned Stage 4 workouts
    // still resolve them. Execution content is immutable in exerciseVersions.

    match /exerciseTemplates/{exerciseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                     && request.resource.data.keys().hasOnly([
                          'ownerId', 'currentVersion', 'createdBy', 'createdAt',
                          'updatedAt', 'updatedBy', 'deletedAt', 'deletedBy',
                          'tags', 'folderId', 'provenance'
                        ])
                     && request.resource.data.ownerId == request.auth.uid
                     && request.resource.data.createdBy == request.auth.uid
                     && request.resource.data.updatedBy == request.auth.uid
                     && hasValidLibraryMetadata(
                         request.resource.data, 'exercise'
                        )
                     && (!('provenance' in request.resource.data)
                        || request.resource.data.provenance == null
                        || (request.resource.data.provenance.copiedBy
                              == request.auth.uid
                            && request.resource.data.provenance.copiedAt
                               == request.time))
                     && request.resource.data.currentVersion == 1
                     && existsAfter(
                          /databases/$(database)/documents/exerciseTemplates/$(exerciseId)/exerciseVersions/1
                        );
      allow update: if isSignedIn()
                    && templateOwner(resource.data) == request.auth.uid
                    && preservesTemplateOwnership()
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'ownerId', 'currentVersion', 'updatedAt',
                           'updatedBy', 'deletedAt', 'deletedBy', 'name',
                           'description', 'instructions', 'videoUrl',
                           'mediaUrls', 'exerciseType',
                           'measurementConfiguration',
                           'gradingConfiguration', 'tags', 'folderId',
                           'provenance'
                         ])
                    && preservesProvenance()
                    && hasValidLibraryMetadataUpdate(
                         request.resource.data, 'exercise'
                       )
                    && ((templateVersion(request.resource.data)
                          == templateVersion(resource.data)
                         && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly([
                                'ownerId', 'updatedAt', 'updatedBy',
                                'deletedAt', 'deletedBy', 'tags', 'folderId'
                              ]))
                        || publishesNextExerciseVersion(exerciseId)
                        || publishesLegacyExerciseEdit(exerciseId))
                     && (templateVersion(resource.data) != 0
                        || templateVersion(request.resource.data) == 0
                        || preservesLegacyExerciseAsVersionOne(exerciseId));
      allow delete: if false;

      match /exerciseVersions/{versionNumber} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && templateOwner(
                           getAfter(
                             /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                           ).data
                         ) == request.auth.uid
                      && request.resource.data.keys().hasOnly([
                           'versionNumber', 'name', 'description',
                           'instructions', 'videoUrl', 'mediaUrls',
                           'exerciseType', 'measurementConfiguration',
                           'gradingConfiguration', 'publishedAt', 'publishedBy'
                         ])
                      && versionNumber
                         == string(request.resource.data.versionNumber)
                      && request.resource.data.versionNumber >= 1
                      && request.resource.data.publishedBy == request.auth.uid
                      && ((!exists(
                             /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                           )
                           && request.resource.data.versionNumber == 1
                           && getAfter(
                                /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                              ).data.currentVersion == 1)
                          || (exists(
                                /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                              )
                              && ((templateVersion(
                                     get(
                                       /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                                     ).data
                                   ) + 1
                                   == request.resource.data.versionNumber
                                   && getAfter(
                                        /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                                      ).data.currentVersion
                                      == request.resource.data.versionNumber)
                                  || (templateVersion(
                                        get(
                                          /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                                        ).data
                                      ) == 0
                                      && request.resource.data.versionNumber
                                         in [1, 2]
                                      && getAfter(
                                           /databases/$(database)/documents/exerciseTemplates/$(exerciseId)
                                         ).data.currentVersion == 2))));
        allow update, delete: if false;
      }
    }

    // ── Workout Templates ──
    // Reads remain signed-in during the Stage 4 compatibility window because
    // assigned workouts still resolve live workout documents.
    // Create/update/delete: owner only.

    match /workoutTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                      && request.resource.data.ownerId == request.auth.uid
                      && request.resource.data.createdBy == request.auth.uid
                      && (!('updatedBy' in request.resource.data)
                          || request.resource.data.updatedBy
                             == request.auth.uid)
                      && hasValidLibraryMetadata(
                           request.resource.data, 'workout'
                         )
                      && (!('provenance' in request.resource.data)
                          || request.resource.data.provenance == null
                          || (request.resource.data.provenance.copiedBy
                                == request.auth.uid
                              && request.resource.data.provenance.copiedAt
                                 == request.time));
      allow update: if isSignedIn()
                    && templateOwner(resource.data) == request.auth.uid
                    && preservesTemplateOwnership()
                    && (!('updatedBy' in request.resource.data)
                        || request.resource.data.updatedBy == request.auth.uid)
                    && preservesProvenance()
                    && hasValidLibraryMetadataUpdate(
                         request.resource.data, 'workout'
                       )
                    && (templateVersion(request.resource.data)
                          == templateVersion(resource.data)
                        || publishesNextWorkoutVersion(templateId));
      allow delete: if false;

      // Workout template versions (subcollection)
      match /workoutTemplateVersions/{versionNumber} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                       && templateOwner(
                           get(/databases/$(database)/documents/workoutTemplates/$(templateId)).data)
                          == request.auth.uid
                       && versionNumber
                          == string(request.resource.data.versionNumber)
                       && request.resource.data.versionNumber >= 1
                       && request.resource.data.storageFormat
                          == 'exercisePrescriptionSubcollection'
                       && !('exercises' in request.resource.data)
                       && request.resource.data.prescriptionCount is int
                       && request.resource.data.prescriptionCount >= 0
                       && request.resource.data.prescriptionCount <= 9
                       && templateVersion(
                            get(
                              /databases/$(database)/documents/workoutTemplates/$(templateId)
                            ).data
                          ) + 1 == request.resource.data.versionNumber
                       && getAfter(
                            /databases/$(database)/documents/workoutTemplates/$(templateId)
                          ).data.currentVersion
                          == request.resource.data.versionNumber;
        allow update, delete: if false;

        match /exercisePrescriptions/{sortOrder} {
          allow read: if isSignedIn();
          allow create: if isSignedIn()
                         && templateOwner(
                             get(
                               /databases/$(database)/documents/workoutTemplates/$(templateId)
                             ).data
                           ) == request.auth.uid
                         && request.resource.data.keys().hasOnly([
                             'exerciseId', 'exerciseVersion', 'sortOrder',
                             'exerciseName', 'prescription'
                           ])
                         && sortOrder == string(request.resource.data.sortOrder)
                         && request.resource.data.sortOrder >= 0
                         && request.resource.data.exerciseVersion >= 1
                         && isOwnedExerciseVersion(
                             request.resource.data.exerciseId,
                             request.resource.data.exerciseVersion
                           )
                         && !exists(
                             /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                           )
                         && versionNumber == string(
                             getAfter(
                               /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                             ).data.versionNumber
                           )
                         && request.resource.data.sortOrder
                           < getAfter(
                               /databases/$(database)/documents/workoutTemplates/$(templateId)/workoutTemplateVersions/$(versionNumber)
                             ).data.prescriptionCount;
          allow update, delete: if false;
        }
      }
    }

    // ── Programs ──
    // Read: owner, or actively enrolled athlete
    // Create: self (ownerId must match auth uid)
    // Update/delete: owner only

    match /programs/{programId} {
      allow read: if isSignedIn()
                    && (resource.data.ownerId == request.auth.uid
                        || isEnrolledActive(programId));
      allow create: if isSignedIn()
                      && request.resource.data.ownerId == request.auth.uid
                      && request.resource.data.createdBy == request.auth.uid
                      && (!('updatedBy' in request.resource.data)
                          || request.resource.data.updatedBy
                             == request.auth.uid)
                      && hasValidLibraryMetadata(
                           request.resource.data, 'program'
                         )
                      && (!('provenance' in request.resource.data)
                          || request.resource.data.provenance == null
                          || (request.resource.data.provenance.copiedBy
                                == request.auth.uid
                              && request.resource.data.provenance.copiedAt
                                 == request.time));
      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.createdBy == resource.data.createdBy
                    && (!('updatedBy' in request.resource.data)
                        || request.resource.data.updatedBy == request.auth.uid)
                    && preservesProvenance()
                    && hasValidLibraryMetadataUpdate(
                         request.resource.data, 'program'
                       )
                    && (templateVersion(request.resource.data)
                          == templateVersion(resource.data)
                        || publishesNextProgramVersion(programId));
      allow delete: if false;

      // Program versions (subcollection)
      match /programVersions/{versionNumber} {
        allow read: if isSignedIn()
                      && (get(/databases/$(database)/documents/programs/$(programId)).data.ownerId
                          == request.auth.uid
                          || isEnrolledActive(programId));
        allow create: if isSignedIn()
                       && get(
                            /databases/$(database)/documents/programs/$(programId)
                          ).data.ownerId == request.auth.uid
                       && versionNumber
                          == string(request.resource.data.versionNumber)
                       && request.resource.data.versionNumber >= 1
                       && templateVersion(
                            get(
                              /databases/$(database)/documents/programs/$(programId)
                            ).data
                          ) + 1 == request.resource.data.versionNumber
                       && getAfter(
                            /databases/$(database)/documents/programs/$(programId)
                          ).data.currentVersion
                          == request.resource.data.versionNumber;
        allow update, delete: if false;
      }
    }

    // ── Library Folders ──
    // Owner- and template-type-scoped folders. The legacy collection name is
    // retained so existing program folder IDs remain stable.
    // Read: owner only.
    // Create: self (ownerId must match auth uid).
    // Update/delete: owner only.

    match /programFolders/{folderId} {
      allow read: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
                      && request.resource.data.keys().hasOnly([
                           'ownerId', 'itemType', 'name', 'createdBy',
                           'createdAt', 'updatedBy', 'updatedAt', 'deletedAt',
                           'deletedBy'
                         ])
                      && request.resource.data.ownerId == request.auth.uid
                      && (!('createdBy' in request.resource.data)
                          || request.resource.data.createdBy
                             == request.auth.uid)
                      && (!('updatedBy' in request.resource.data)
                          || request.resource.data.updatedBy
                             == request.auth.uid)
                      && (!('itemType' in request.resource.data)
                          || request.resource.data.itemType
                             in ['exercise', 'workout', 'program'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0;
      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && (!('createdBy' in resource.data)
                        || request.resource.data.createdBy
                           == resource.data.createdBy)
                    && (!('updatedBy' in request.resource.data)
                        || request.resource.data.updatedBy == request.auth.uid)
                    && ((!('itemType' in request.resource.data)
                         && !('itemType' in resource.data))
                        || request.resource.data.itemType
                           == libraryFolderType(resource.data))
                    && ((request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly([
                             'itemType', 'name', 'updatedBy', 'updatedAt'
                           ])
                         && ((!('deletedAt' in resource.data)
                              && !('deletedAt' in request.resource.data))
                             || request.resource.data.deletedAt
                                == resource.data.deletedAt))
                        || (request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly([
                                'itemType', 'updatedBy', 'updatedAt',
                                'deletedAt', 'deletedBy'
                              ])
                            && request.resource.data.deletedAt == request.time
                            && request.resource.data.deletedBy
                               == request.auth.uid));
      allow delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && (!('itemType' in resource.data)
                        || (resource.data.deletedAt != null
                            && resource.data.deletedBy == request.auth.uid));
    }

    // ── Enrollments ──
    // Read: program owner or the enrolled athlete.
    //   resource == null allows a get() of a non-existent enrollment to
    //   return "not found" instead of permission-denied — required by the
    //   isEnrolled() check when adding a not-yet-enrolled athlete. For
    //   queries (list) resource is always populated, so this does not widen
    //   query exposure.
    // Create/update: program owner only (and program must be assignable)
    // No hard delete

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn()
                    && (resource == null
                        || resource.data.athleteId == request.auth.uid
                        || resource.data.addedBy == request.auth.uid);
      allow create: if isSignedIn()
                      && isProgramOwner(request.resource.data.programId)
                      && isProgramAssignable(request.resource.data.programId)
                      && (request.resource.data.athleteId == request.auth.uid
                          || hasActiveTrainerClientRelationship(
                               request.auth.uid,
                               request.resource.data.athleteId))
                      && request.resource.data.addedBy == request.auth.uid;
      allow update: if isSignedIn()
                      && isProgramOwner(resource.data.programId)
                      && isProgramAssignable(resource.data.programId)
                      && request.resource.data.programId
                         == resource.data.programId
                      && request.resource.data.athleteId
                         == resource.data.athleteId
                      && request.resource.data.addedBy
                         == resource.data.addedBy
                      && (request.resource.data.status != 'active'
                          || resource.data.athleteId == request.auth.uid
                          || hasActiveTrainerClientRelationship(
                               request.auth.uid,
                               resource.data.athleteId));
    }

    // ── Workout Instances ──
    // Read: athlete, assigning user (legacy), or immutable program owner.
    // Create: program owner assigns workouts, or an actively enrolled athlete
    //   assigns a workout to themselves.
    // Update: athlete can complete/edit own; owner can edit scheduling
    //   fields only (reschedule, swap workout, cancel) — never completion
    //   data (rpe, duration, notes, actuals, load), which is athlete-only.

    match /workoutInstances/{instanceId} {
      allow read: if isSignedIn()
                    && (resource.data.athleteId == request.auth.uid
                        || resource.data.assignedBy == request.auth.uid
                        || resource.data.programOwnerId == request.auth.uid);
      allow create: if isSignedIn()
                      && request.resource.data.assignedBy == request.auth.uid
                      && hasValidProgramOwner(request.resource.data)
                      && hasActiveRelationshipForProgram(request.resource.data)
                      && (isProgramOwner(request.resource.data.programId)
                          || (request.resource.data.athleteId
                                == request.auth.uid
                              && isEnrolledActive(
                                   request.resource.data.programId)));
      allow update: if isSignedIn()
                      && preservesProgramOwner()
                      && (resource.data.athleteId == request.auth.uid
                          || (isProgramOwner(resource.data.programId)
                              && hasActiveRelationshipForProgram(resource.data)
                              && request.resource.data.diff(resource.data)
                                   .affectedKeys()
                                   .hasOnly(['status', 'scheduledDate',
                                             'workoutTemplateId',
                                             'workoutTemplateVersion',
                                             'workoutType', 'updatedAt'])));
      allow delete: if isSignedIn()
                      && (resource.data.athleteId == request.auth.uid
                          || resource.data.assignedBy == request.auth.uid);
    }
  }
}
